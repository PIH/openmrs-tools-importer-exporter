# Settings for one migration (one source server into ZL Central).
# Create the real file with ./00-create-settings.sh (it asks for each value and offers lookups).
# Keep the real file OUTSIDE the repo and point MIGRATION_ENV at it (or pass it as the first argument).
# Never put passwords in it: MySQL root passwords are read from the container itself or prompted.
# Format: one NAME=value per line, directly under its comment. 00-create-settings.sh reads this file.

# test = nothing is ever written to the source server; real = the actual migration.
MIGRATION_MODE=test
# Short lower-case name of the source site (e.g. hsn); used in retire reasons "Migrating from <name>".
SOURCE_NAME=
# ssh alias of the source server, or "local" to run on this machine.
SOURCE_HOST=
# ssh alias of the target (ZL Central) server, or "local".
TARGET_HOST=
# How docker is called on the source server.
SOURCE_DOCKER="sudo docker"
# How docker is called on the target server.
TARGET_DOCKER="sudo docker"
# Source MySQL password handling: container-env (read from the container) or prompt (typed once per script).
SOURCE_MYSQL_AUTH=container-env
# Target MySQL password handling: container-env or prompt.
TARGET_MYSQL_AUTH=container-env
# Name of the MySQL docker container on the source server.
SOURCE_MYSQL_CONTAINER=mysql56
# Name of the MySQL docker container on the target server.
TARGET_MYSQL_CONTAINER=
# Database name on the source MySQL.
SOURCE_DB=
# Database name on the target MySQL.
TARGET_DB=openmrs
# Username of the user the importer logs in as on the target (the migrating user).
MIGRATING_USERNAME=
# The source site's dossier number prefix, as in idgen_seq_id_gen on the target.
DOSSIER_PREFIX=
# Prefix for order numbers of the migrated orders (must differ from other sites').
ORDER_NUMBER_PREFIX=
# UUID of the source site's facility location (type "?name" to search by part of the name).
SOURCE_FACILITY_UUID=
# UUID of the person attribute type "Health Center" on the target.
HEALTH_CENTER_ATTRIBUTE_TYPE_UUID=
# Working folder on this machine: logs, mapping files, review lists. May hold user data.
WORKDIR=
# Required, no default: a folder owned by your ssh user on that server, e.g. /home/<you>/migration (importer checkout and export files).
SOURCE_SERVER_DIR=
# Required, no default: a folder owned by your ssh user on that server, e.g. /home/<you>/migration (importer checkout, exports, logs).
TARGET_SERVER_DIR=
# OpenMRS URL as seen from the source server itself.
SOURCE_OPENMRS_URL=http://localhost:8080/openmrs
# OpenMRS URL as seen from the target server itself.
TARGET_OPENMRS_URL=http://localhost:8080/openmrs
# Command that restarts OpenMRS on the target server (not on the wiki; check on the server).
TARGET_RESTART_CMD="cd /home/tomcat/docker && sudo docker compose restart"
# URL polled on the target (from the target) until OpenMRS is up again (check on the server).
TARGET_WAIT_URL=http://localhost:8080/openmrs/login.htm
# Command that restarts OpenMRS on the source server (not on the wiki; check on the server).
SOURCE_RESTART_CMD="cd /home/tomcat/docker && sudo docker compose restart"
# Docker compose folder on the source server, used to shut it down at the end.
SOURCE_COMPOSE_DIR=/home/tomcat/docker
# Backup commands to run on the source before migrating, separated by ; (wiki step 9).
SOURCE_BACKUP_CMDS="sudo /usr/local/sbin/mysqlbackup.sh; sudo /usr/bin/flock -n /home/tomcat/backups/cron.backupAzure.lock /usr/local/sbin/backupAzure.sh"
# Backup commands to run on the target before migrating, separated by ; (wiki step 9).
TARGET_BACKUP_CMDS="sudo /usr/local/sbin/mysqlbackup.sh; sudo /usr/bin/flock -n /home/tomcat/backups/cron.backupAzure.lock /usr/local/sbin/backupAzure.sh"
# OpenMRS application data folder on the source server (holds complex_obs, storage, person_images).
SOURCE_DATA_DIR=/home/tomcat/.OpenMRS
# OpenMRS application data folder on the target server.
TARGET_DATA_DIR=/home/tomcat/.OpenMRS
# Runtime properties file on the target server.
TARGET_RUNTIME_PROPERTIES="$TARGET_DATA_DIR/openmrs-runtime.properties"
# Folders in the data folder copied from source to target, space separated.
COPY_DIRS="complex_obs storage person_images"
# Owner (user:group) of copied files on the target server.
TARGET_FILE_OWNER=tomcat:tomcat
# Docker image the importer runs in.
NODE_IMAGE=node:22.18.0
# Git URL of the importer repository, cloned on the servers.
REPO_URL=https://github.com/PIH/openmrs-tools-importer-exporter.git
# Branch, tag or commit of the importer to check out.
REPO_REF=main
# How many patients the importer sends per batch.
IMPORT_PATIENTS_BATCH_SIZE=30
# Optional (laptop path): user role mappings file for the export.
EXPORT_USER_ROLE_MAPPINGS_FILE=
# Optional (laptop path): patient identifier type mappings file for the export.
EXPORT_PATIENT_IDENTIFIERS_MAPPINGS_FILE=
# Optional (laptop path): program workflow state mappings file for the export.
EXPORT_PROGRAM_WORKFLOW_STATE_MAPPINGS_FILE=
# Optional (laptop path): concept name mappings file for the export.
EXPORT_CONCEPT_NAME_MAPPINGS_FILE=
# Optional earlier imports for verifyUsers re-runs, separated by ; each as exportsdir|usermappings|facilityuuid.
EARLIER_IMPORTS=
# In test mode, skip copying password hashes (true or false).
SKIP_HASH_COPY_IN_TEST=false
# Seconds to wait for the target to come back up after a restart.
WAIT_TIMEOUT_SECONDS=1800
